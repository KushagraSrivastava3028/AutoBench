# Where the Next dev server proxies /api to.
AUTOBENCH_API_URL=http://localhost:8000
# Require UI sign-in when backend AUTOBENCH_AUTH_REQUIRED is also true.
AUTOBENCH_AUTH_REQUIRED=false
# Set the external HTTPS origin when a reverse proxy changes the Host header.
# AUTOBENCH_PUBLIC_URL=https://autobench.example.com
