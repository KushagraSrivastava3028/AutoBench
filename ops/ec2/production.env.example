# Copy to production.env on the EC2 host, then chmod 600. Never commit it.
# JSON lists are required for the two Google allowlists.
AUTOBENCH_HOSTNAME=bench.example.org
AUTOBENCH_PUBLIC_URL=https://bench.example.org
ACME_EMAIL=ops@example.org
AUTOBENCH_RELEASE=local
POSTGRES_PASSWORD=REPLACE_WITH_RANDOM_HEX
VALKEY_PASSWORD=REPLACE_WITH_DIFFERENT_RANDOM_HEX
AUTOBENCH_DATABASE_URL=postgresql+asyncpg://autobench:REPLACE_WITH_RANDOM_HEX@postgres:5432/autobench
AUTOBENCH_REDIS_URL=redis://:REPLACE_WITH_DIFFERENT_RANDOM_HEX@valkey:6379/0
AUTOBENCH_GOOGLE_OAUTH_CLIENT_ID=REPLACE.apps.googleusercontent.com
AUTOBENCH_GOOGLE_OAUTH_CLIENT_SECRET=REPLACE_ON_HOST
AUTOBENCH_GOOGLE_WORKSPACE_DOMAINS=["example.org"]
AUTOBENCH_GOOGLE_BOOTSTRAP_ADMINS=["owner@example.org"]
AUTOBENCH_SESSION_TTL_SEC=28800
AUTOBENCH_CORS_ORIGINS=["https://bench.example.org"]
AUTOBENCH_S3_BUCKET=REPLACE_WITH_STACK_OUTPUT
AUTOBENCH_S3_REGION=ap-south-1
# Omit endpoint/access/secret settings: boto3 uses the EC2 instance role.
AUTOBENCH_ANTHROPIC_API_KEY=
AUTOBENCH_OPENAI_API_KEY=
AUTOBENCH_GOOGLE_API_KEY=
AUTOBENCH_CAPTURE_CONTENT=false
AUTOBENCH_LOG_LEVEL=INFO
