# Copy to .env. Every setting is AUTOBENCH_-prefixed; nested ones use __.

# --- zero-infrastructure local mode (the defaults) --------------------------
AUTOBENCH_ENVIRONMENT=development
AUTOBENCH_EXECUTOR=local          # docker for real isolation
AUTOBENCH_QUEUE=memory            # redis for multi-process workers
AUTOBENCH_ARTIFACT_BACKEND=local  # s3 for MinIO/S3
AUTOBENCH_DATABASE_URL=sqlite+aiosqlite:///./.autobench/autobench.db

# --- model providers (optional; the mock model needs none) ------------------
AUTOBENCH_ANTHROPIC_API_KEY=
AUTOBENCH_OPENAI_API_KEY=
AUTOBENCH_GOOGLE_API_KEY=
AUTOBENCH_OPENAI_COMPAT_BASE_URL=   # vLLM / Ollama
AUTOBENCH_OPENAI_COMPAT_API_KEY=

# --- concurrency lanes -------------------------------------------------------
AUTOBENCH_WORKER__MAX_CONTAINERS=8
AUTOBENCH_WORKER__MAX_DOCKER_OPS=4
AUTOBENCH_WORKER__MAX_VERIFIERS=4
AUTOBENCH_PROVIDER__REQUESTS_PER_MINUTE=1000
AUTOBENCH_PROVIDER__TOKENS_PER_MINUTE=2000000

# --- observability -----------------------------------------------------------
AUTOBENCH_OTLP_ENDPOINT=
AUTOBENCH_CAPTURE_CONTENT=false

# --- Google Workspace sign-in (optional locally) ---------------------------
# Set AUTH_REQUIRED=true in both API and frontend for protected deployments.
AUTOBENCH_AUTH_REQUIRED=false
AUTOBENCH_PUBLIC_URL=http://localhost:3000
AUTOBENCH_GOOGLE_OAUTH_CLIENT_ID=
AUTOBENCH_GOOGLE_OAUTH_CLIENT_SECRET=
AUTOBENCH_GOOGLE_WORKSPACE_DOMAINS=["example.org"]
AUTOBENCH_GOOGLE_BOOTSTRAP_ADMINS=["owner@example.org"]
# Register exactly: https://your-hostname/api/auth/google/callback
